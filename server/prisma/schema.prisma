generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMPANY
  ADMIN
  MUNICIPAL_ADMIN
  MUNICIPAL_EVALUATOR
}

enum TaxStatus {
  HABIDO
  NO_HABIDO
  NO_HALLADO
}

enum Schedule {
  CALL_FOR_APPLICATIONS
  PARTICIPANT_REGISTRATION
  SUBMISSION_OF_PROPOSALS
  AWARD_OF_TENDER
}

enum DocumentTypes {
  TXT
  DOC
  DOCX
  PDF
  RTF
  ODT
  MD
}

enum StatusTender {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CLOSED
  ARCHIVED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  role         Role
  isActive     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyProfile    CompanyProfile?
  adminProfile      AdminProfile?
  localAdminProfile LocalAdminProfile?
  localEvaluator    LocalEvaluator?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  userInvitations     UserInvitation[]

  auditLogs AuditLog[]
}

model CompanyProfile {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @unique @db.Uuid
  ruc           String     @unique
  companyName   String?
  taxStatus     TaxStatus?
  fiscalAddress String?
  fiscalStatus Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AdminProfile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @unique @db.Uuid
  firstName String?
  lastName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model LocalAdminProfile {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  firstName      String?
  lastName       String?
  municipalityId String  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  municipality Municipality @relation(fields: [municipalityId], references: [id])
}

model LocalEvaluator {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  firstName      String?
  lastName       String?
  municipalityId String  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  municipality Municipality @relation(fields: [municipalityId], references: [id])
  tenders      Tenders[]
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Municipality {
  localAdminProfile LocalAdminProfile[]
  localEvaluator    LocalEvaluator[]
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  location        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs AuditLog[]
}

model UserInvitation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Actors {
  USER
  ANONYMOUS
  SYSTEM
}

enum Status {
  SUCCESS
  FAILED
  DENIED
}

enum TargetType {
  USER
  AUTH_SESSION
  COMPANY_PROFILE
  ADMIN_PROFILE
  LOCAL_ADMIN_PROFILE
  LOCAL_EVALUATOR_PROFILE
  MUNICIPALITY
  PASSWORD_RESET_TOKEN
  TENDER
  TENDER_SCHEDULE
  DOCUMENT
  STATUS_LOG
  USER_INVITATION
}

model AuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  actorId        String? @db.Uuid
  actorType      Actors
  actorRole      Role?
  municipalityId String? @db.Uuid

  action    String
  status    Status
  errorCode String?

  targetType TargetType?
  targetId   String?

  ipAddress      String?
  userAgent      String?
  additionalData Json?
  createdAt      DateTime @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
}
model Tenders {
  id              String   @id @default(uuid()) @db.Uuid
  idCreator       String   @db.Uuid
  status          StatusTender
  title           String
  location        String
  coorX           Float
  coorY           Float
  description     String
  executionPeriod String
  contact         String
  municipality    String
  createdAt       DateTime  @default(now())

  tenderSchedule  TenderSchedule[]
  documentsTender DocumentsTender[]
  statusLogs      StatusLogs[]
  requirements    Requirements[]

  localEvaluator  LocalEvaluator @relation(fields: [idCreator], references: [id])
}

model TenderSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  idTender          String   @db.Uuid
  schedule          Schedule
  scheduleTimeLine  String
  createdAt         DateTime @default(now())
  
  tenders           Tenders @relation(fields: [idTender], references: [id])
}

model DocumentsTender{
  id              String   @id @default(uuid()) @db.Uuid
  idTender        String   @db.Uuid
  documentType    DocumentTypes
  fileName        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenders         Tenders @relation(fields: [idTender], references: [id])
}

model StatusLogs {
  id        String   @id @default(uuid()) @db.Uuid
  idTender  String   @db.Uuid
  action    StatusTender
  message   String
  createdAt DateTime @default(now())

  tenders   Tenders @relation(fields: [idTender], references: [id])
}

model Requirements {
  id               String   @id @default(uuid()) @db.Uuid
  idTender         String   @db.Uuid
  requirement      String
  validationSchema Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenders     Tenders @relation(fields: [idTender], references: [id])
}
